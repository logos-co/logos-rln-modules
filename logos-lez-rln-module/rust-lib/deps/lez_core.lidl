; lez_core contract — the subset the RLN module uses. Supplied as
; a dependency_override: the consumer generates a typed
; LezCoreClient from just these three methods instead of the full
; wallet surface. Signatures must stay in sync with the wallet module's own
; interface (src/lez_core_module.h upstream; the module id was
; logos_execution_zone before logos-execution-zone-module@01c6f40).
;
; Call sites (rust-lib/src/lib.rs): resolve_account_id ->
; account_id_from_base58; fetch_account_data* -> get_account_public;
; register_member / claim_tokens ->
; send_generic_public_transaction. The caller passes
; account_ids/signing_requirements/instruction as QVariant-wrapped
; QVariantLists and treats an EMPTY string return as failure.
; Original C++ call-site evidence: git show 4b403c1:logos-lez-rln-module/src/logos_lez_rln_module.cpp
module lez_core {
  version "0.4.0"

  ; Decode a base58 account id to 64 hex chars; empty string on failure.
  method account_id_from_base58(base58_str: tstr) -> tstr description "Decode a base58 account id to 64 hex chars; empty string on failure."

  ; JSON {program_owner, balance, nonce, data} (all hex); empty string on
  ; failure. The RLN module derives PDAs from program_owner and parses the
  ; membership/config state out of data.
  method get_account_public(account_id_hex: tstr) -> tstr description "Fetch public account state as JSON {program_owner, balance, nonce, data} (all hex); empty string on failure."

  ; instruction is a list of u32 words (borsh Vec<u32> LE re-packed by the
  ; caller); typed `any` because today's C++ codegen maps
  ; std::vector<uint32_t> to the opaque QVariant. Success returns JSON
  ; {success, tx_hash, secrets, error}; failure returns {success, tx_hash,
  ; error} (no secrets key) or the empty string if the QtRO call itself dies.
  method send_generic_public_transaction(account_ids: [tstr], signing_requirements: [bool], instruction: any, program_id_hex: tstr) -> tstr description "Submit a generic public transaction: parallel account_ids/signing_requirements arrays, u32-word instruction stream, 32-byte program id hex. Returns JSON {success, tx_hash, secrets, error} (no secrets key on failure)."
}
