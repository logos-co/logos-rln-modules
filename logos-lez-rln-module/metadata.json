{
  "name": "liblogos_lez_rln_module",
  "display_name": "LEZ RLN Module",
  "version": "7.0.0",
  "description": "RLN registry provider (LEZ chain reads + registration/funding txs)",
  "author": "Logos Blockchain Team",
  "type": "core",
  "interface": "cdylib",
  "concurrency": "multi",
  "category": "blockchain",
  "main": "liblogos_lez_rln_module_plugin",
  "dependencies": [
    "lez_core"
  ],
  "dependency_overrides": {
    "lez_core": {
      "file": "rust-lib/deps/lez_core.lidl"
    }
  },
  "include": [],
  "capabilities": [],
  "codegen": {
    "lidl": "rust-lib/liblogos_lez_rln_module.lidl",
    "rust": {
      "crate": "rust-lib"
    }
  },
  "nix": {
    "external_libraries": [],
    "packages": {
      "build": [],
      "runtime": []
    },
    "cmake": {
      "find_packages": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    },
    "rust": {
      "toolchain": "1.94.0",
      "packages": {
        "build": [
          "pkg-config",
          "perl",
          "protobuf",
          "cmake",
          "python3",
          "clang"
        ],
        "runtime": []
      },
      "env": {
        "RISC0_SKIP_BUILD_KERNELS": "1"
      }
    }
  }
}
